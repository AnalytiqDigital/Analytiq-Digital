# Public site URL (no trailing slash) — used for canonical/OG tags & sitemap
NEXT_PUBLIC_SITE_URL=https://www.analytiq.ng

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=info@analytiq.ng
CONTACT_RECEIVING_EMAIL=info@analytiq.ng

# WhatsApp — international format, no leading +, no spaces (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348124314217
# Optional: Cal.com or Calendly booking link for "Book a Free Consultation"
NEXT_PUBLIC_BOOKING_URL=https://cal.com/analytiq-digital/15min

# Optional: analytics
NEXT_PUBLIC_GA_ID=

# Optional: email delivery provider for the contact form (e.g. Resend)
RESEND_API_KEY=

# Admin auth
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Database — leave both unset for local development (uses a local libSQL
# file at ./data/app.db automatically). Set both to point at a hosted
# Turso database for production — see README.md "Migrating to Turso or
# Postgres for production".
DATABASE_URL=
DATABASE_AUTH_TOKEN=
ADMIN_EMAIL=admin@analytiq.ng
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Google Reviews (server-only — never exposed to the client)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
VERCEL_BLOB_TOKEN=replace-with-your-vercel-blob-token

# WhatsApp Cloud API (Meta) — powers the AI assistant webhook at
# /api/webhooks/whatsapp. From developers.facebook.com → your app → WhatsApp.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-string-you-choose
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI model for the WhatsApp agent (any OpenAI-compatible API, e.g. OpenRouter)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Optional: public knowledge-base document the agent answers from.
# For a Google Doc shared as "anyone with the link", use:
# https://docs.google.com/document/d/<DOC_ID>/export?format=txt
KNOWLEDGE_BASE_URL=
