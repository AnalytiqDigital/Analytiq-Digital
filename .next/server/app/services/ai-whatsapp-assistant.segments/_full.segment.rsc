13:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"AI WhatsApp Assistant\",\"description\":\"AI WhatsApp assistant development for Nigerian businesses — automate customer service, sales enquiries, and order handling directly on WhatsApp.\",\"provider\":{\"@id\":\"https://www.analytiq.ng/#organization\"},\"areaServed\":[\"Nigeria\",\"Abuja\"],\"url\":\"https://www.analytiq.ng/services/ai-whatsapp-assistant\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Will it sound robotic or annoy customers?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The assistant is scripted around your actual products and tone, not a generic template, and is built to hand off to a human quickly rather than trap customers in a loop.\"}},{\"@type\":\"Question\",\"name\":\"Can it take orders directly?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, for straightforward order flows. More complex ordering (e.g. inventory-checked, multi-item) is scoped alongside our Custom Software or Inventory solutions.\"}},{\"@type\":\"Question\",\"name\":\"Do we need the official WhatsApp Business API?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For a reliable, scalable assistant, yes — we help set this up as part of the engagement rather than relying on an unofficial workaround.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.analytiq.ng/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://www.analytiq.ng/services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"AI WhatsApp Assist